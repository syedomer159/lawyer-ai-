# Copy to .env and fill in. Blank values mean "use the default".

# Which models play each role: local | hybrid | cloud (see config/models.yaml).
# cloud = Gemini Flash Lite / Flash (fast, cheap); local = Ollama only (free, slow on CPU).
MODEL_PROFILE=cloud
OLLAMA_BASE_URL=http://localhost:11434/v1

# Cloud provider keys: set only the ones config/models.yaml uses (default: Gemini).
GEMINI_API_KEY=
# Or several Gemini keys, comma-separated: used in rotation; invalid / out-of-quota keys are
# skipped (status in data/gemini_keys.json). Check them: uv run python -m app.llm.keys --check
GEMINI_API_KEYS=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Tracing to Arize Phoenix. TRACE_CONTENT=false in deployment: traces keep tokens/latency
# but drop confidential case text.
TRACING=true
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
TRACE_CONTENT=true

# Where case folders live (default: ./data).
DATA_DIR=
